{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "error"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "expression"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "component_refs": {
          "items": {
            "type": "string"
          },
          "title": "Component Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Block",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "manufacturer_part_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer Part Number"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "functional_class": {
          "$ref": "#/$defs/FunctionalClass",
          "default": "other"
        },
        "symbol_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol Ref"
        },
        "footprint_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footprint Ref"
        },
        "pins": {
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "title": "Pins",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "uuid": {
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "reference"
      ],
      "title": "Component",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "operator": {
          "description": "e.g. eq, ne, lt, lte, gt, gte, in, between",
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "name",
        "operator",
        "value"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "ElectricalRole": {
      "enum": [
        "power_in",
        "power_out",
        "ground",
        "digital_in",
        "digital_out",
        "digital_bidir",
        "open_drain",
        "analog_in",
        "analog_out",
        "clock",
        "reset",
        "boot",
        "enable",
        "no_connect",
        "passive",
        "unspecified"
      ],
      "title": "ElectricalRole",
      "type": "string"
    },
    "Endpoint": {
      "additionalProperties": false,
      "description": "A pin on a component attached to a net (hyperedge member).",
      "properties": {
        "component_ref": {
          "title": "Component Ref",
          "type": "string"
        },
        "pin_number": {
          "title": "Pin Number",
          "type": "string"
        },
        "pin_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pin Name"
        }
      },
      "required": [
        "component_ref",
        "pin_number"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Citation into curated facts, datasheets, rules, or prior findings.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "rule | datasheet | component_profile | fixture | erc | note",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FunctionalClass": {
      "enum": [
        "mcu",
        "sensor",
        "regulator_ldo",
        "regulator_buck",
        "transceiver",
        "connector",
        "passive",
        "protection",
        "interface_bridge",
        "programming",
        "test",
        "other"
      ],
      "title": "FunctionalClass",
      "type": "string"
    },
    "Net": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "class": {
          "$ref": "#/$defs/NetClass",
          "default": "unspecified"
