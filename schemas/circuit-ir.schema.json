  "additionalProperties": false,
  "description": "Top-level typed circuit IR document.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "source_tool": {
      "$ref": "#/$defs/SourceTool",
      "default": "kicad"
