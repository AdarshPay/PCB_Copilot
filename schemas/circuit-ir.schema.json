        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "uuid": {
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Net",
      "type": "object"
    },
    "NetClass": {
      "enum": [
        "power",
        "ground",
        "signal",
        "bus",
        "differential",
        "unspecified"
      ],
      "title": "NetClass",
      "type": "string"
    },
    "Pin": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "title": "Number",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "electrical_role": {
          "$ref": "#/$defs/ElectricalRole",
          "default": "unspecified"
        },
        "interface_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Role"
        },
        "voltage_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage Domain"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "number",
        "name"
      ],
      "title": "Pin",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
